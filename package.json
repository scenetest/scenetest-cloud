{
  "name": "scenetest-cloud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:worker": "wrangler dev",
    "dev:dashboard": "vite",
    "build:dashboard": "vite build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@scenetest/vite-plugin": "^0.9.2",
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.90.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@scenetest/vite-plugin": "patches/@scenetest__vite-plugin.patch"
    }
  }
}
