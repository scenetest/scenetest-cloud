{
  "name": "scenetest-cloud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -n worker,dashboard -c blue,magenta \"pnpm dev:worker\" \"pnpm dev:dashboard:watch\"",
    "dev:worker": "node -e \"fs.mkdirSync('dist/dashboard',{recursive:true})\" && wrangler dev",
    "dev:dashboard": "vite",
    "dev:dashboard:watch": "vite build --watch",
    "build:dashboard": "vite build",
    "deploy": "pnpm build:dashboard && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@scenetest/dashboard": "^0.11.0",
    "@scenetest/protocol": "^0.11.0",
    "@tanstack/react-query": "^5.101.0",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.1",
    "concurrently": "^10.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
